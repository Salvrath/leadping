NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Direct, non-redirecting base URL used by telephony delivery callbacks.
# Production: https://www.textback.se
TEXTBACK_WEBHOOK_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
# Optional direct Google Ads conversion tracking for successful lead submissions.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Required before public self-service commerce is enabled.
NEXT_PUBLIC_TEXTBACK_LEGAL_NAME=
NEXT_PUBLIC_TEXTBACK_ORG_NUMBER=
NEXT_PUBLIC_TEXTBACK_ADDRESS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly recurring price: 99500 öre SEK, excluding VAT.
STRIPE_STANDARD_PRICE_ID=
# Repeating coupon: 50000 öre SEK off for exactly 3 months.
STRIPE_LAUNCH_COUPON_ID=

RESEND_API_KEY=
TEXTBACK_NOTIFICATION_EMAIL=info@textback.se
TEXTBACK_FROM_EMAIL=Textback <info@textback.se>

# Internal operations panel. Use unique random values; password >=12 chars, secret >=32 chars.
TEXTBACK_ADMIN_PASSWORD=
TEXTBACK_ADMIN_SECRET=
# Signs isolated customer portal sessions. Use a separate random value with at least 32 characters.
TEXTBACK_CUSTOMER_SESSION_SECRET=

# Missed-call SMS delivery. Keep log mode until a real 46elks number is configured and verified.
# Allowed values: log, dryrun, live
TEXTBACK_SMS_MODE=log
TEXTBACK_DEDUPE_MINUTES=60
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
# Shared secret appended to all 46elks callback URLs.
ELKS_WEBHOOK_SECRET=
# 46elks number configuration:
# voice_start=https://www.textback.se/api/telephony/46elks/incoming?secret=<ELKS_WEBHOOK_SECRET>
# sms_url=https://www.textback.se/api/telephony/46elks/incoming-sms?secret=<ELKS_WEBHOOK_SECRET>
# Delivery callbacks are generated automatically by the SMS sender.

# Protects the internal retry worker. Vercel Cron sends this as a Bearer token when configured.
CRON_SECRET=
# Protects detailed /api/health readiness output. Public requests only receive liveness data.
HEALTHCHECK_SECRET=
